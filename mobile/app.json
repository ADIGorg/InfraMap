{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "inframap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O InfraMap usa sua localização para identificar a área do problema registrado."
        }
      ],
      [
          "expo-camera",
          {
            "cameraPermission": "O InfraMap usa a câmera para registrar evidências fotográficas de problemas urbanos. Suas fotos ficam privadas até você autorizar a exibição pública."
          }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
