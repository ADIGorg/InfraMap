# ==========================================
# AMBIENTE DA APLICAÇÃO
# ==========================================

# Ambiente de execução: development, test ou production
NODE_ENV=development

# Porta em que a API será executada
PORT=3000


# ==========================================
# SUPABASE
# ==========================================

# URL do projeto Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (Publishable Key) do Supabase
SUPABASE_PUBLISHABLE_KEY=sua_publishable_key


# ==========================================
# SEGURANÇA HTTP - CORS
# ==========================================

# Origens autorizadas a acessar a API pelo navegador.
# Separe múltiplas origens por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ==========================================
# LOGGING
# ==========================================

# Nível mínimo de registro dos logs:
# fatal, error, warn, info, debug ou trace
LOG_LEVEL=info


# ==========================================
# API1-46 - INTELIGÊNCIA ARTIFICIAL
# ==========================================

AI_PROVIDER=mock
AI_API_URL=https://api.openai.com/v1/responses
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_PROMPT_VERSION=v1
AI_CONFIDENCE_THRESHOLD=0.70
