# InfraMap — configuração de exemplo. Nunca versione chaves reais.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Provedor: mock (desenvolvimento), gemini (análise real) ou http (legado).
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_PROMPT_VERSION=v1
AI_CONFIDENCE_THRESHOLD=0.70

# Legado: usado somente com AI_PROVIDER=http
AI_API_URL=https://api.openai.com/v1/responses
AI_API_KEY=
