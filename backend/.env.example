# ==========================================
# Supabase — obrigatórias
# ==========================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ==========================================
# Supabase — service_role (apenas backend)
# ==========================================
# Usado por: AI upload, finalize (move photo), deactivate account auth cleanup.
# NUNCA expor no frontend/mobile.
SUPABASE_SECRET_KEY=sb_secret_...

# ==========================================
# Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Segurança
# ==========================================
# Lista CSV de origens permitidas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# IA
# ==========================================
# mock | http
AI_PROVIDER=mock
# AI_API_URL=https://api.openai.com/v1/responses
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_PROMPT_VERSION=v1
# AI_CONFIDENCE_THRESHOLD=0.70

# ==========================================
# Logging
# ==========================================
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ==========================================
# Testes
# ==========================================
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
TEST_USER_PHONE=
RUN_SUPABASE_INTEGRATION=false
